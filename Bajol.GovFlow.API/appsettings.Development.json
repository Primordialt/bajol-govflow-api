{
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=govflow;Username=govflow;Password=govflow",
    "Redis": "localhost:6379"
  },
  "Elasticsearch": {
    "Enabled": false,
    "Uri": "http://localhost:9200"
  },
  "Jwt": {
    "Issuer": "https://govflow.local",
    "Audience": "govflow.api",
    "SigningKey": "dev-only-symmetric-key-minimum-32-characters-long!!",
    "RequireHttpsMetadata": false
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  }
}
