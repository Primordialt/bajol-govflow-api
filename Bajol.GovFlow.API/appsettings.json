{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=govflow;Username=govflow;Password=govflow",
    "Redis": "localhost:6379"
  },
  "Elasticsearch": {
    "Enabled": false,
    "Uri": "http://localhost:9200"
  },
  "Jwt": {
    "Issuer": "https://govflow.local",
    "Audience": "govflow.api",
    "SigningKey": "CHANGE_ME__USE_SECRET_MANAGER_OR_KEY_VAULT__32_CHARS_MIN_",
    "RequireHttpsMetadata": true
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
